#version 430 core
layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(r16f, binding = 1) writeonly uniform image3D gyroidMap;

void main() {
    ivec3 id = ivec3(gl_GlobalInvocationID);
    float texSize = 64.0;

    if (id.x >= 64 || id.y >= 64 || id.z >= 64) return;

    // Map [0, 64) spatial coordinates to [0, 2PI)
    vec3 p = (vec3(id) / texSize) * 6.28318530718;

    vec3 s = sin(p);
    vec3 c = cos(p);
    float val = s.x * c.y + s.y * c.z + s.z * c.x;

    // We only need a single channel (RED) for the float value
    imageStore(gyroidMap, id, vec4(val, 0.0, 0.0, 0.0));
}
